<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#55FFFFFF">

    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#153E9C" />
                    <gradient
                        android:angle="0"
                        android:startColor="#174AB8"
                        android:endColor="#2E63D6" />
                </shape>
            </item>

            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#2968EA" />
                    <gradient
                        android:angle="0"
                        android:startColor="#1E5EE8"
                        android:endColor="#4079F0" />
                </shape>
            </item>
        </selector>
    </item>

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>

</ripple>
